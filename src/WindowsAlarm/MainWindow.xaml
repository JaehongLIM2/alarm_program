<Window x:Class="WindowsAlarm.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:WindowsAlarm" Title="Windows Alarm" Width="700" Height="920"
        MinWidth="560" MinHeight="640" Style="{StaticResource AppWindowStyle}"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,12">
      <StackPanel>
        <!-- Cancellation stays outside the disabled settings/actions container. -->
        <Grid x:Name="AlarmReservationRow" Visibility="Collapsed" Margin="0,0,0,10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBlock Text="{local:Loc Key=0}" Foreground="{StaticResource MutedBrush}" FontSize="13" />
            <TextBlock x:Name="ScheduleText" FontSize="15" FontWeight="Bold" Margin="0,4,0,0" />
          </StackPanel>
          <Button x:Name="CancelWakeButton" Grid.Column="1" Content="{local:Loc Key=1}" Click="CancelWake_Click"
                  Style="{StaticResource CompactButtonStyle}" Margin="0" VerticalAlignment="Center" />
        </Grid>
        <Grid x:Name="ShutdownReservationRow" Visibility="Collapsed" Margin="0,0,0,10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBlock Text="{local:Loc Key=2}" Foreground="{StaticResource MutedBrush}" FontSize="13" />
            <TextBlock x:Name="ShutdownText" FontSize="15" FontWeight="Bold" Margin="0,4,0,0" />
          </StackPanel>
          <Button x:Name="CancelShutdownButton" Grid.Column="1" Content="{local:Loc Key=3}" Click="CancelShutdown_Click"
                  Style="{StaticResource CompactButtonStyle}" Margin="0" VerticalAlignment="Center" />
        </Grid>
        <TextBlock x:Name="ShutdownOutcomeText" Visibility="Collapsed" Style="{StaticResource HelpTextStyle}" Margin="0,0,0,6" />
        <TextBlock x:Name="StatusText" Foreground="#1D4ED8" FontSize="14" Margin="0,0,0,8" />
        <StackPanel IsEnabled="{Binding IsEnabled, ElementName=SettingsPanel}">
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Button Content="{local:Loc Key=4}" Click="Test_Click" Margin="0,0,4,0" />
            <Button Grid.Column="1" Content="{local:Loc Key=5}" Click="Save_Click" Margin="4,0,0,0" />
          </Grid>
          <Button Content="{local:Loc Key=6}" Style="{StaticResource PrimaryButtonStyle}" FontWeight="Bold"
                  Margin="0" Click="Hibernate_Click" />
        </StackPanel>
      </StackPanel>
    </Border>
    <Grid DockPanel.Dock="Top" Margin="24,20,24,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock Text="Windows Alarm" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
      <Button x:Name="LanguageButton" Grid.Column="1" Content="{Binding SwitchLabel, Source={x:Static local:Localization.Current}}"
              Click="Language_Click" Style="{StaticResource CompactButtonStyle}" Margin="8,0,8,0"
              AutomationProperties.Name="{local:Loc Key=184}" ToolTip="한국어 ↔ 日本語" />
      <Button Grid.Column="2" Content="{local:Loc Key=7}" Click="PowerInfo_Click" Style="{StaticResource CompactButtonStyle}" Margin="0,0,8,0" />
      <Button x:Name="MoreButton" Grid.Column="3" Content="⋯" FontSize="22" Width="38" Padding="0"
              Style="{StaticResource CompactButtonStyle}" Margin="0" Click="More_Click" AutomationProperties.Name="{local:Loc Key=8}" ToolTip="{local:Loc Key=8}">
        <Button.ContextMenu>
          <ContextMenu FontFamily="{Binding Font, Source={x:Static local:Localization.Current}}" FontSize="15" Padding="4"
                       TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
            <MenuItem Header="{local:Loc Key=9}" Click="Logs_Click" Padding="12,8" />
            <MenuItem Header="{local:Loc Key=10}" Click="About_Click" Padding="12,8" />
            <MenuItem Header="{local:Loc Key=11}" Click="FontLicense_Click" Padding="12,8" />
          </ContextMenu>
        </Button.ContextMenu>
      </Button>
    </Grid>
    <ScrollViewer x:Name="SettingsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="24,0,24,16">
        <StackPanel x:Name="SettingsPanel">
          <Border Style="{StaticResource CardStyle}">
            <StackPanel>
              <TextBlock Text="{local:Loc Key=12}" Style="{StaticResource FieldLabelStyle}" />
              <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="HourBox" AutomationProperties.Name="{local:Loc Key=13}" Width="102" FontSize="28" FontWeight="Bold" />
                <TextBlock Text=":" FontSize="28" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0" />
                <ComboBox x:Name="MinuteBox" AutomationProperties.Name="{local:Loc Key=14}" Width="102" FontSize="28" FontWeight="Bold" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardStyle}">
            <StackPanel>
              <TextBlock Text="{local:Loc Key=15}" Style="{StaticResource FieldLabelStyle}" />
              <DockPanel>
                <Button Content="{local:Loc Key=16}" DockPanel.Dock="Right" Click="ClearYouTube_Click" Margin="8,0,0,0"
                        AutomationProperties.Name="{local:Loc Key=17}" ToolTip="{local:Loc Key=18}" />
                <TextBox x:Name="YouTubeBox" AutomationProperties.Name="YouTube URL" />
              </DockPanel>
              <TextBlock Text="{local:Loc Key=19}"
                         Style="{StaticResource HelpTextStyle}" Margin="0,8,0,0" />
              <TextBlock Text="{local:Loc Key=20}" Style="{StaticResource FieldLabelStyle}" Margin="0,20,0,8" />
              <DockPanel>
                <Button Content="{local:Loc Key=21}" DockPanel.Dock="Right" Click="Browse_Click" Margin="8,0,0,0" />
                <TextBox x:Name="MusicBox" AutomationProperties.Name="{local:Loc Key=22}" />
              </DockPanel>
              <TextBlock Text="{local:Loc Key=23}"
                         Style="{StaticResource HelpTextStyle}" Margin="0,8,0,0" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardStyle}">
            <StackPanel>
              <ToggleButton x:Name="MaxVolumeToggle" Content="{local:Loc Key=24}"
                            Style="{StaticResource ToggleSwitchStyle}" AutomationProperties.Name="{local:Loc Key=25}" Margin="0,0,0,18" />
              <TextBlock Text="{local:Loc Key=26}" Style="{StaticResource FieldLabelStyle}" />
              <ComboBox x:Name="VolumeAfterStopBox" HorizontalAlignment="Stretch" AutomationProperties.Name="{local:Loc Key=26}"
                        IsEnabled="{Binding IsChecked, ElementName=MaxVolumeToggle}">
                <ComboBoxItem Content="{local:Loc Key=27}" />
                <ComboBoxItem Content="{local:Loc Key=28}" />
              </ComboBox>
              <Border Height="1" Background="#F4F4F5" Margin="0,22" />
              <ToggleButton x:Name="ShutdownToggle" Content="{local:Loc Key=29}" Style="{StaticResource ToggleSwitchStyle}"
                            AutomationProperties.Name="{local:Loc Key=29}" Margin="0,0,0,12" />
              <WrapPanel>
                <TextBlock Text="{local:Loc Key=30}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="ShutdownMinutesBox" Width="80" MaxLength="4" AutomationProperties.Name="{local:Loc Key=31}" />
                <TextBlock Text="{local:Loc Key=32}" VerticalAlignment="Center" Margin="8,0,0,0" />
              </WrapPanel>
              <TextBlock Text="{local:Loc Key=33}"
                         Style="{StaticResource HelpTextStyle}" Margin="0,12,0,0" />
            </StackPanel>
          </Border>

        </StackPanel>

        <Border x:Name="AlarmPanel" Visibility="Collapsed" Style="{StaticResource CardStyle}"
                Background="#FFFBEB" BorderBrush="#FDE68A">
          <StackPanel>
            <TextBlock Text="{local:Loc Key=34}" FontSize="22" FontWeight="Bold" />
            <TextBlock x:Name="AudioStatusText" Margin="0,10,0,0" />
            <Button Content="{local:Loc Key=35}" Style="{StaticResource StopButtonStyle}" FontSize="24" FontWeight="Bold"
                    Click="Stop_Click" Margin="0,16,0,0" />
            <TextBlock Text="{local:Loc Key=36}"
                       Style="{StaticResource HelpTextStyle}" Margin="0,10,0,0" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>

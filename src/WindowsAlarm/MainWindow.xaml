<Window x:Class="WindowsAlarm.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Windows Alarm" Width="700" Height="920"
        MinWidth="560" MinHeight="640" Style="{StaticResource AppWindowStyle}"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,12">
      <StackPanel>
        <Grid IsEnabled="{Binding IsEnabled, ElementName=SettingsPanel}" Margin="0,0,0,8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Button Content="설정 저장" Click="Save_Click" />
          <Button Grid.Column="1" Content="알람 테스트" Click="Test_Click" />
          <Button Grid.Column="2" Content="알람 설정 후 최대 절전" Style="{StaticResource PrimaryButtonStyle}" FontWeight="Bold"
                  Margin="0,4" Click="Hibernate_Click" />
        </Grid>
        <WrapPanel>
          <Button Content="알람 예약 취소" Click="CancelWake_Click" Style="{StaticResource CompactButtonStyle}" />
          <Button Content="PC 자동 종료 취소" Click="CancelShutdown_Click" Style="{StaticResource CompactButtonStyle}" />
          <Button Content="로그 폴더" Click="Logs_Click" Style="{StaticResource CompactButtonStyle}" />
          <Button Content="전원 상태 확인" Click="PowerInfo_Click" Style="{StaticResource CompactButtonStyle}" />
          <Button Content="글꼴 라이선스" Click="FontLicense_Click" Style="{StaticResource CompactButtonStyle}" />
        </WrapPanel>
        <TextBlock Text="최근 PC 사용·활동 확인 실패 시 응답이 없으면 자동 종료를 취소합니다. 창을 닫으면 진행 중인 자동 종료는 취소되고 미래 알람 예약은 유지됩니다."
                   Style="{StaticResource HelpTextStyle}" Margin="0,6,0,0" />
      </StackPanel>
    </Border>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="24">
        <TextBlock Text="Windows Alarm" FontSize="28" FontWeight="Bold" Margin="0,0,0,20" />
        <StackPanel x:Name="SettingsPanel">
          <Border Style="{StaticResource CardStyle}">
            <StackPanel>
              <TextBlock Text="알람 시간" Style="{StaticResource FieldLabelStyle}" />
              <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="HourBox" AutomationProperties.Name="알람 시" Width="102" FontSize="28" FontWeight="Bold" />
                <TextBlock Text=":" FontSize="28" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0" />
                <ComboBox x:Name="MinuteBox" AutomationProperties.Name="알람 분" Width="102" FontSize="28" FontWeight="Bold" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardStyle}">
            <StackPanel>
              <TextBlock Text="YouTube URL (선택)" Style="{StaticResource FieldLabelStyle}" />
              <TextBox x:Name="YouTubeBox" AutomationProperties.Name="YouTube URL" />
              <TextBlock Text="내장 플레이어에서 재생을 확인합니다. 20초 내 확인 실패·오류 시 YouTube를 종료하고 로컬 음악으로 전환합니다."
                         Style="{StaticResource HelpTextStyle}" Margin="0,8,0,0" />
              <TextBlock Text="로컬 백업 음악 (MP3)" Style="{StaticResource FieldLabelStyle}" Margin="0,20,0,8" />
              <DockPanel>
                <Button Content="찾아보기" DockPanel.Dock="Right" Click="Browse_Click" Margin="8,0,0,0" />
                <TextBox x:Name="MusicBox" AutomationProperties.Name="로컬 MP3 파일 경로" />
              </DockPanel>
              <TextBlock Text="미지정·삭제·재생 실패 시 내장 경고음을 사용합니다. PC 볼륨을 확인하세요."
                         Style="{StaticResource HelpTextStyle}" Margin="0,8,0,0" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardStyle}">
            <StackPanel>
              <ToggleButton x:Name="MaxVolumeToggle" Content="알람 중 Windows 볼륨을 100으로 설정 (음소거 해제)"
                            Style="{StaticResource ToggleSwitchStyle}" AutomationProperties.Name="알람 중 Windows 볼륨을 100으로 설정" Margin="0,0,0,18" />
              <TextBlock Text="알람 종료 후 볼륨" Style="{StaticResource FieldLabelStyle}" />
              <ComboBox x:Name="VolumeAfterStopBox" HorizontalAlignment="Stretch" AutomationProperties.Name="알람 종료 후 볼륨"
                        IsEnabled="{Binding IsChecked, ElementName=MaxVolumeToggle}">
                <ComboBoxItem Content="원래 볼륨과 음소거 상태로 복원" />
                <ComboBoxItem Content="볼륨 0으로 변경 (음소거하지 않음)" />
              </ComboBox>
              <Border Height="1" Background="#F4F4F5" Margin="0,22" />
              <ToggleButton x:Name="ShutdownToggle" Content="자동 종료 사용" Style="{StaticResource ToggleSwitchStyle}"
                            AutomationProperties.Name="자동 종료 사용" Margin="0,0,0,12" />
              <WrapPanel>
                <TextBlock Text="알람 시작 후" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="ShutdownMinutesBox" Width="80" MaxLength="4" AutomationProperties.Name="자동 종료까지 분" />
                <TextBlock Text="분 뒤, 60초 카운트다운" VerticalAlignment="Center" Margin="8,0,0,0" />
              </WrapPanel>
            </StackPanel>
          </Border>

        </StackPanel>

        <Border x:Name="AlarmPanel" Visibility="Collapsed" Style="{StaticResource CardStyle}"
                Background="#FFFBEB" BorderBrush="#FDE68A">
          <StackPanel>
            <TextBlock Text="알람이 울리고 있습니다" FontSize="22" FontWeight="Bold" />
            <TextBlock x:Name="AudioStatusText" Margin="0,10,0,0" />
            <Button Content="알람 정지" Style="{StaticResource StopButtonStyle}" FontSize="24" FontWeight="Bold"
                    Click="Stop_Click" Margin="0,16,0,0" />
            <TextBlock Text="알람 정지는 모든 소리를 멈추고 선택한 종료 후 볼륨을 적용합니다. 자동 종료 예약은 유지됩니다."
                       Style="{StaticResource HelpTextStyle}" Margin="0,10,0,0" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource CardStyle}" Background="#EFF6FF" BorderBrush="#BFDBFE" Margin="0">
          <StackPanel>
            <TextBlock Text="예약 상태" FontWeight="Bold" />
            <TextBlock x:Name="ScheduleText" Text="예약 없음" Margin="0,10,0,6" />
            <TextBlock x:Name="ShutdownText" Text="자동 종료 예약 없음" Foreground="#52525B" />
            <TextBlock x:Name="StatusText" Margin="0,10,0,0" Foreground="#1D4ED8" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>

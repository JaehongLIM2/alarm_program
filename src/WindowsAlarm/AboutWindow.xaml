<Window x:Class="WindowsAlarm.AboutWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:WindowsAlarm" Title="{local:Loc Key=10}"
        Width="560" Height="460" MinWidth="460" MinHeight="360" Style="{StaticResource AppWindowStyle}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,12">
      <Button Content="{local:Loc Key=39}" Click="Close_Click" IsDefault="True" IsCancel="True" HorizontalAlignment="Right"
              Style="{StaticResource PrimaryButtonStyle}" Margin="0" />
    </Border>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="24">
        <TextBlock Text="Windows Alarm" FontSize="28" FontWeight="Bold" />
        <TextBlock Text="{local:Loc Path=AuthorLabel}" Margin="0,8,0,22" Foreground="{StaticResource MutedBrush}" />
        <Border Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock Text="{local:Loc Key=40}" Style="{StaticResource FieldLabelStyle}" />
            <TextBlock FontSize="15">
              <Hyperlink x:Name="RepositoryLink" NavigateUri="{Binding RepositoryUri}" RequestNavigate="Link_RequestNavigate"
                         Foreground="{StaticResource AccentBrush}" ToolTip="{local:Loc Key=41}">
                <Run Text="{Binding RepositoryUrl, Mode=OneWay}" />
              </Hyperlink>
            </TextBlock>
            <TextBlock Text="{local:Loc Key=42}" Style="{StaticResource FieldLabelStyle}" Margin="0,22,0,8" />
            <TextBlock FontSize="15">
              <Hyperlink x:Name="ContactLink" NavigateUri="{Binding ContactUri}" RequestNavigate="Link_RequestNavigate"
                         Foreground="{StaticResource AccentBrush}" ToolTip="{local:Loc Key=43}">
                <Run Text="{Binding ContactEmail, Mode=OneWay}" />
              </Hyperlink>
            </TextBlock>
          </StackPanel>
        </Border>
        <TextBlock Text="{local:Loc Key=44}"
                   Style="{StaticResource HelpTextStyle}" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>

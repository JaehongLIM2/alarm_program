<Window x:Class="WindowsAlarm.AboutWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="프로그램 정보"
        Width="560" Height="460" MinWidth="460" MinHeight="360" Style="{StaticResource AppWindowStyle}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,12">
      <Button Content="닫기" Click="Close_Click" IsDefault="True" IsCancel="True" HorizontalAlignment="Right"
              Style="{StaticResource PrimaryButtonStyle}" Margin="0" />
    </Border>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="24">
        <TextBlock Text="Windows Alarm" FontSize="28" FontWeight="Bold" />
        <TextBlock Text="{Binding Author, StringFormat=제작 · {0}}" Margin="0,8,0,22" Foreground="{StaticResource MutedBrush}" />
        <Border Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock Text="프로젝트 GitHub" Style="{StaticResource FieldLabelStyle}" />
            <TextBlock FontSize="15">
              <Hyperlink x:Name="RepositoryLink" NavigateUri="{Binding RepositoryUri}" RequestNavigate="Link_RequestNavigate"
                         Foreground="{StaticResource AccentBrush}" ToolTip="기본 브라우저에서 프로젝트 열기">
                <Run Text="{Binding RepositoryUrl, Mode=OneWay}" />
              </Hyperlink>
            </TextBlock>
            <TextBlock Text="문의 메일" Style="{StaticResource FieldLabelStyle}" Margin="0,22,0,8" />
            <TextBlock FontSize="15">
              <Hyperlink x:Name="ContactLink" NavigateUri="{Binding ContactUri}" RequestNavigate="Link_RequestNavigate"
                         Foreground="{StaticResource AccentBrush}" ToolTip="기본 메일 앱에서 작성하기">
                <Run Text="{Binding ContactEmail, Mode=OneWay}" />
              </Hyperlink>
            </TextBlock>
          </StackPanel>
        </Border>
        <TextBlock Text="사용한 글꼴의 저작권과 이용 조건은 더보기 → 글꼴 라이선스에서 확인할 수 있습니다."
                   Style="{StaticResource HelpTextStyle}" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>

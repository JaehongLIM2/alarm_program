<Window x:Class="WindowsAlarm.ShutdownWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Windows Alarm · 종료 확인"
        Width="520" Height="290" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Topmost="True"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="15" Background="#FFF8E8">
  <StackPanel Margin="24">
    <TextBlock x:Name="MessageText" FontSize="21" FontWeight="SemiBold" />
    <TextBlock x:Name="DetailText" Margin="0,14,0,14" />
    <WrapPanel>
      <Button x:Name="CancelButton" Content="자동 종료 취소" IsDefault="True" IsCancel="True" Click="Cancel_Click" />
      <Button x:Name="ShutdownButton" Content="지금 종료" Click="Shutdown_Click" />
    </WrapPanel>
  </StackPanel>
</Window>

<Window x:Class="WindowsAlarm.PowerStatusWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:WindowsAlarm" Title="{local:Loc Key=46}"
        Width="660" Height="800" MinWidth="540" MinHeight="500" Style="{StaticResource AppWindowStyle}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,12">
      <WrapPanel HorizontalAlignment="Right">
        <Button Content="{local:Loc Key=47}" Click="OpenPowerOptions_Click" />
        <Button Content="{local:Loc Key=48}" Click="Refresh_Click" />
        <Button Content="{local:Loc Key=39}" Click="Close_Click" IsDefault="True" IsCancel="True" Margin="0,4,0,4" Style="{StaticResource PrimaryButtonStyle}" />
      </WrapPanel>
    </Border>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="24">
        <TextBlock Text="{local:Loc Key=46}" FontSize="24" FontWeight="Bold" Margin="0,0,0,16" />
        <Border Style="{StaticResource CardStyle}" Background="#EFF6FF" BorderBrush="#BFDBFE" Padding="16">
          <StackPanel>
            <TextBlock Text="{local:Loc Path=Summary}" FontSize="17" FontWeight="Bold" />
            <TextBlock Text="{local:Loc Path=PowerSource}" Margin="0,8,0,4" />
            <TextBlock Text="{local:Loc Path=ReadAt}" Style="{StaticResource HelpTextStyle}" />
          </StackPanel>
        </Border>
        <ItemsControl ItemsSource="{Binding Checks}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                  <DockPanel Margin="0,0,0,8">
                  <TextBlock DockPanel.Dock="Right" Text="{local:Loc Path=Value}" FontSize="15" FontWeight="Bold" Margin="12,0,0,0" MaxWidth="250" TextWrapping="Wrap">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#B45309" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsReady}" Value="True"><Setter Property="Foreground" Value="#15803D" /></DataTrigger>
                          <DataTrigger Binding="{Binding IsUnknown}" Value="True"><Setter Property="Foreground" Value="#62626A" /></DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <TextBlock Text="{local:Loc Path=Title}" FontSize="15" FontWeight="Bold" />
                  </DockPanel>
                  <TextBlock Text="{local:Loc Path=Explanation}" Style="{StaticResource HelpTextStyle}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Style="{StaticResource CardStyle}" Padding="16">
          <StackPanel>
            <TextBlock Text="{local:Loc Key=49}" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" />
            <TextBlock Text="{local:Loc Key=50}" FontSize="15" FontWeight="Bold" />
            <TextBlock Text="{local:Loc Key=51}" Style="{StaticResource HelpTextStyle}" Margin="0,6,0,8" />
            <TextBox Text="powercfg /hibernate on&#10;powercfg /h /type full&#10;powercfg /a" IsReadOnly="True" TextWrapping="NoWrap" VerticalContentAlignment="Top" AutomationProperties.Name="{local:Loc Key=52}" />
            <TextBlock Text="{local:Loc Key=53}" FontSize="15" FontWeight="Bold" Margin="0,18,0,6" />
            <TextBlock Text="{local:Loc Key=54}" Style="{StaticResource HelpTextStyle}" />
            <TextBlock Text="{local:Loc Key=55}" Style="{StaticResource HelpTextStyle}" Margin="0,8,0,0" />
          </StackPanel>
        </Border>
        <TextBlock Text="{local:Loc Key=56}" Style="{StaticResource HelpTextStyle}" Margin="0,0,0,12" />
        <TextBlock Text="{local:Loc Key=57}" Style="{StaticResource HelpTextStyle}" Margin="0,0,0,12" />
        <Expander Header="{local:Loc Key=58}">
          <TextBox Text="{Binding Diagnostics}" IsReadOnly="True" TextWrapping="Wrap" FontSize="13" Margin="0,10,0,0" />
        </Expander>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
